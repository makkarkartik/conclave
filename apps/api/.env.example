# Copy to .env and adjust. All settings have dev defaults matching docker-compose.yml.

# Postgres (docker compose up -d db)
CONCLAVE_DATABASE_URL=postgresql+psycopg://conclave:conclave@localhost:5433/conclave

# Any non-empty string; BYOK API keys are Fernet-encrypted with a key derived from it.
# Changing it makes previously stored provider keys undecryptable.
CONCLAVE_SECRET_KEY=dev-insecure-change-me

# 1 = run the turn-runner inside the API process (local dev).
# 0 = API only; run the runner separately: python -m conclave.runner
CONCLAVE_EMBED_RUNNER=1

# Optional overrides
# CONCLAVE_DATA=../../data
# CONCLAVE_RUNNER_CONCURRENCY=8
# CONCLAVE_LEASE_SECONDS=90
